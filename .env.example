# =============================================================================
# Hefesto Studio — Kit Baserow
# .env.example — PLANTILLA. NO contiene ningún secreto real.
#
# Todos los valores de ejemplo son claramente falsos y sirven solo de patrón.
#
# ---------------------------------------------------------------------------
# CÓMO GENERAR LOS SECRETOS (ejecutar en el servidor, nunca copiar de aquí)
# ---------------------------------------------------------------------------
#   SECRET_KEY                 ->  openssl rand -base64 32
#   BASEROW_JWT_SIGNING_KEY    ->  openssl rand -base64 32   (independiente)
#   DATABASE_PASSWORD          ->  openssl rand -base64 32
#   REDIS_PASSWORD             ->  openssl rand -base64 32
#
# Cada clave debe generarse por SEPARADO. Reutilizar un valor entre variables
# aumenta el daño si se filtra una sola de ellas.
#
# Después:  cp .env.example .env  ->  chmod 600 .env  ->  editar .env
# ============================================================================

# -----------------------------------------------------------------------------
# BLOQUE OBLIGATORIO
# Compose aborta el arranque si falta cualquiera de estas (sintaxis ${VAR:?}).
# -----------------------------------------------------------------------------

# OBLIGATORIA. Clave de cifrado interna de Django/Baserow.
# Fuente: la genera el operador. Si la cambias después de instalar, quedan
# invalidas las sesiones y las cookies existentes.
SECRET_KEY=REEMPLAZAR_CON_SALIDA_DE_openssl_rand_base64_32

# OBLIGATORIA. Contraseña del PostgreSQL INTERNO de Baserow (servicio `db`).
# Si usas un PostgreSQL externo en lugar del servicio `db`, es la contraseña de
# ese servidor externo.
DATABASE_PASSWORD=REEMPLAZAR_CON_SALIDA_DE_openssl_rand_base64_32

# OBLIGATORIA. Contraseña del Redis interno (servicio `redis`).
REDIS_PASSWORD=REEMPLAZAR_CON_SALIDA_DE_openssl_rand_base64_32

# -----------------------------------------------------------------------------
# BLOQUE RECOMENDADO
# -----------------------------------------------------------------------------

# RECOMENDADA. Si la dejas vacía, Baserow usa SECRET_KEY como clave de firma
# JWT. Definirla por separado permite rotar una sin tocar la otra.
BASEROW_JWT_SIGNING_KEY=

# Debe coincidir EXACTAMENTE con la URL con la que el usuario abre el sitio.
# Si no coincide, los enlaces de archivos y correos salen rotos y Baserow
# puede tratar el sitio como "aplicación publicada" ajena.
BASEROW_PUBLIC_URL=http://localhost

# Versión de Baserow. Fijada en 2.4.1; ver VERSION.md.
BASEROW_VERSION=2.4.1

# -----------------------------------------------------------------------------
# PUBLICACIÓN DE PUERTOS
# -----------------------------------------------------------------------------
# El servicio `caddy` es el único que publica puertos.

# Dirección del host donde se publica. Usa 127.0.0.1 si hay otro proxy delante
# (Nginx, Traefik, Coolify). Ojo: Docker puede saltarse las reglas de ufw al
# publicar en 0.0.0.0. Ver docs/01.
HOST_PUBLISH_IP=0.0.0.0

WEB_FRONTEND_PORT=80
WEB_FRONTEND_SSL_PORT=443

# Para HTTPS gestionado por Caddy (debe ser :443):
#   BASEROW_PUBLIC_URL=https://tudominio.cl
#   BASEROW_CADDY_ADDRESSES=:443
BASEROW_CADDY_ADDRESSES=:80

# -----------------------------------------------------------------------------
# BASE DE DATOS INTERNA
# -----------------------------------------------------------------------------
# Con estos valores vacíos, Baserow usa el servicio `db` de este compose
# (PostgreSQL 15 con pgvector) en la red privada, sin puertos publicados.
DATABASE_USER=baserow
DATABASE_NAME=baserow

# Para usar un PostgreSQL EXTERNO en lugar del servicio `db`, define:
#   DATABASE_HOST=...
#   DATABASE_PORT=5432
#   DATABASE_URL=postgresql://usuario:clave@host:puerto/base
# Ver docs/09 antes de hacerlo. Nunca pongas sslmode=disable contra una base
# que no esté en la misma red privada sin documentarlo con el cliente.

# -----------------------------------------------------------------------------
# CORREO SALIENTE (opcional)
# -----------------------------------------------------------------------------
# Sin esto Baserow NO envía correos: no hay invitaciones, ni recuperación de
# contraseña, ni avisos. En una instalación interna suele bastar con dejarlo
# vacío y crear los usuarios a mano.
EMAIL_SMTP=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=
EMAIL_SMTP_USE_TLS=
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
FROM_EMAIL=

# -----------------------------------------------------------------------------
# AJUSTES DE LA INSTALACIÓN
# -----------------------------------------------------------------------------

# Fija la edición abierta. Deja las funciones premium fuera aunque alguien
# registre una licencia en esta instancia.
BASEROW_OSS_ONLY=true

# Búsqueda de texto completo en PostgreSQL. Requiere la extensión pgvector,
# que ya viene en la imagen pgvector/pgvector:pg15.
BASEROW_USE_PG_FULLTEXT_SEARCH=false

# Tamaño máximo de archivo importable, en megabytes.
BASEROW_MAX_IMPORT_FILE_SIZE_MB=512

# Nivel de detalle del log del backend.
BASEROW_BACKEND_LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# RECEPTOR DE CORREO ENTRANTE (opcional, tras un perfil de Compose)
# -----------------------------------------------------------------------------
# Solo si usas el disparador "Start workflow by email". Publica el puerto 25
# en el host, asi que exige COMPOSE_PROFILES=inbound-email al arrancar.
# Ver docs/01.
BASEROW_INBOUND_EMAIL_DOMAIN=
BASEROW_INBOUND_EMAIL_WEBHOOK_SECRET=
BASEROW_INBOUND_EMAIL_HOST_SMTP_PORT=25